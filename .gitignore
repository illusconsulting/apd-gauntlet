# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Virtualenvs
.venv/
venv/
env/

# Gauntlet run outputs (runs/) are LOCAL and may contain a sensitive security
# review — never commit them. The entire runs/ tree is ignored so a tool user
# cannot accidentally publish a report. The canonical example fixture lives
# under examples/ and test fixtures under tests/fixtures/.
runs/
# Allow test fixture runs (tracked under tests/).
!tests/fixtures/runs/
!tests/fixtures/runs/**

# Claude Code session-local config (do not commit; .claude/ contents that are part of the plugin payload, e.g. .claude/agents/ and .claude/skills/, are tracked explicitly)
.claude/settings.json
.claude/settings.local.json

# Superpowers brainstorm scratch (visual companion mockups) — local only
.superpowers/
docs/superpowers/
docs/audits/

# NIST CPRT raw exports (inputs to refresh-crosswalks; grounded data committed instead)
docs/cprt_*.json
docs/cprt_*.xlsx
docs/csf-pf-*.xlsx

# Evaluation results and local labels stay out of git (ADR-0028)
eval/results/
eval/local/

# Telemetry exports carry user e-mail, Bash commands and tool input (register A9.6)
telemetry/
