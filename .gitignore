*.swp
*~

# Virtualenvs
.venv/
venv/
env/

# Run outputs (gauntlet runs)
# Exclude direct contents of runs/, then re-include canonical example runs
# (used as fixtures by Phase D tests and the operator quickstart). Each run's
# regenerable HTML report build output stays excluded.
runs/*
!runs/apd-20260527-crapi-owasp-api-top10
!runs/apd-20260527-caldera-adversary-emulation
!runs/apd-20260527-authentik-identity-provider
runs/apd-20260527-crapi-owasp-api-top10/40-synthesis/report-html/
runs/apd-20260527-caldera-adversary-emulation/40-synthesis/report-html/
runs/apd-20260527-authentik-identity-provider/40-synthesis/report-html/
# Allow test fixture runs
!tests/fixtures/runs/
!tests/fixtures/runs/**

# Claude Code session-local config (do not commit; .claude/ contents that are part of the plugin payload, e.g. .claude/agents/ and .claude/skills/, are tracked explicitly)
.claude/settings.json
.claude/settings.local.json
