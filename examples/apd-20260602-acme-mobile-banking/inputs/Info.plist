<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.acme.banking</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Unlock Acme Banking with Face ID.</string>
    <!-- App Transport Security: default system trust, no pinning, no exceptions. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>
    <!-- Custom URL scheme for the transfer deep link. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>acmebank</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
