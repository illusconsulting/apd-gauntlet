{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shoveleejoe/apd-gauntlet/schemas/code-evidence-index.schema.json",
  "title": "APD Code Evidence Index",
  "type": "object",
  "required": ["code_evidence_index"],
  "additionalProperties": false,
  "properties": {
    "code_evidence_index": {
      "type": "object",
      "required": ["indexed_commit_sha", "cbm_project", "generated_at", "entries"],
      "additionalProperties": false,
      "properties": {
        "indexed_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "cbm_project":        { "type": "string", "minLength": 1 },
        "generated_at":       { "type": "string", "format": "date-time" },
        "repos": {
          "type": "array",
          "minItems": 1,
          "description": "Optional list of repositories contributing entries to this index. When present, every entry must carry a repo field identifying which repository it came from.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cbm_project", "indexed_commit_sha"],
            "properties": {
              "cbm_project":        { "type": "string", "minLength": 1 },
              "indexed_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
            }
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entry" }
        }
      },
      "if":   { "required": ["repos"] },
      "then": {
        "properties": {
          "entries": {
            "type": "array",
            "items": { "required": ["repo"] }
          }
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "qualified_name", "kind", "file_path", "line_range", "excerpt", "apd_relevance"],
      "additionalProperties": false,
      "properties": {
        "id":             { "type": "string", "pattern": "^cev-[0-9a-f]{8}$" },
        "qualified_name": { "type": "string", "minLength": 1 },
        "kind":           { "type": "string", "enum": ["function", "class", "route", "consumer", "job", "module", "edge"] },
        "file_path":      { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+$" },
        "line_range":     { "type": "string", "pattern": "^L[0-9]+(-L[0-9]+)?$" },
        "excerpt":        { "type": "string", "minLength": 1 },
        "apd_relevance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "_defs.schema.json#/$defs/apd_goal" }
        },
        "notes":          { "type": "string" },
        "repo":           { "type": "string", "minLength": 1, "description": "Optional CBM project name this entry was attributed to. Required when top-level repos[] is present (multi-repo provenance)." },
        "c4_container":   { "type": "string", "minLength": 1, "description": "Optional C4 container name this code anchor belongs to (additive; consumed by assemble_c4)." },
        "c4_component":   { "type": ["string", "null"], "minLength": 1, "description": "Optional C4 component name; null when L3 is blocked (no artifact groups this symbol)." },
        "c4_level":       { "type": "string", "enum": ["container", "component", "code"], "description": "Optional C4 level this anchor maps to." }
      }
    }
  }
}
