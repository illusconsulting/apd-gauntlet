{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/illusconsulting/apd-gauntlet/schemas/nist-coverage.schema.json",
  "title": "APD Gauntlet NIST 800-53r5 Coverage Row",
  "type": "object",
  "required": ["id", "family", "title", "finding_count", "finding_ids", "capability_count", "capability_ids", "posture"],
  "additionalProperties": false,
  "properties": {
    "id":     { "type": "string", "pattern": "^[A-Z]{2}-[0-9]+(\\([0-9]+\\))?$" },
    "family": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "title":  { "type": "string", "minLength": 5 },
    "finding_count":    { "type": "integer", "minimum": 0 },
    "finding_ids":      { "type": "array", "items": { "type": "string" } },
    "capability_count": { "type": "integer", "minimum": 0 },
    "capability_ids":   { "type": "array", "items": { "type": "string" } },
    "posture":          { "type": "string", "enum": ["silent", "covered", "gapped", "gapped_and_covered"] }
  }
}
