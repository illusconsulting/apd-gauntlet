{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/illusconsulting/apd-gauntlet/schemas/attack-exposure.schema.json",
  "title": "APD Gauntlet ATT&CK Technique Exposure Row",
  "type": "object",
  "required": ["id", "sub_technique", "tactic", "name", "exposure_finding_count", "exposure_finding_ids", "mitigated_by_capabilities"],
  "additionalProperties": false,
  "properties": {
    "id":             { "$ref": "_defs.schema.json#/$defs/attack_technique_id_topline" },
    "sub_technique":  { "$ref": "_defs.schema.json#/$defs/attack_sub_technique_id" },
    "tactic":         { "$ref": "_defs.schema.json#/$defs/attack_tactic_id" },
    "name":           { "type": "string", "minLength": 3 },
    "exposure_finding_count": { "type": "integer", "minimum": 0 },
    "exposure_finding_ids":   { "type": "array", "items": { "type": "string" } },
    "mitigated_by_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "mitigation_id"],
        "additionalProperties": false,
        "properties": {
          "capability_id": { "type": "string" },
          "mitigation_id": { "$ref": "_defs.schema.json#/$defs/attack_mitigation_id" }
        }
      }
    }
  }
}
